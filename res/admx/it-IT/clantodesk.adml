<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <displayName>ClantoDesk</displayName>
  <description>Impostazioni dei criteri di gruppo di ClantoDesk.</description>
  <resources>
    <stringTable>
      <string id="ClantoDesk150">ClantoDesk 1.5.0 o successivo</string>
      <string id="SessionPermissions">Permessi della sessione in entrata</string>
      <string id="InboundSecurity">Sicurezza in ingresso</string>
      <string id="OutgoingSessions">Sessioni in uscita</string>
      <string id="AuditSiem">Audit e SIEM</string>
      <string id="Interface">Interfaccia</string>
      <string id="Configure">Selezionare Abilitata o Disabilitata.</string>
      <string id="Value">Valore:</string>
      <string id="EnableRemotePrinter">Consenti stampante remota</string><string id="EnableRemotePrinter_Help">Stabilisce se le sessioni in entrata possono usare la stampante remota. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableClipboard">Consenti appunti</string><string id="EnableClipboard_Help">Stabilisce la condivisione degli appunti nelle sessioni in entrata. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableFileTransfer">Consenti trasferimento file</string><string id="EnableFileTransfer_Help">Stabilisce il trasferimento di file nelle sessioni in entrata. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableCamera">Consenti fotocamera</string><string id="EnableCamera_Help">Stabilisce l'accesso alla fotocamera nelle sessioni in entrata. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableTerminal">Consenti terminale</string><string id="EnableTerminal_Help">Stabilisce l'accesso al terminale nelle sessioni in entrata. Valore predefinito: disabilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableTunnel">Consenti tunneling TCP</string><string id="EnableTunnel_Help">Stabilisce il tunneling TCP nelle sessioni in entrata. Valore predefinito: disabilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableRemoteRestart">Consenti riavvio remoto</string><string id="EnableRemoteRestart_Help">Stabilisce il riavvio remoto nelle sessioni in entrata. Valore predefinito: disabilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableRecordSession">Consenti registrazione sessione</string><string id="EnableRecordSession_Help">Stabilisce la registrazione delle sessioni in entrata. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableKeyboard">Consenti tastiera e mouse</string><string id="EnableKeyboard_Help">Stabilisce l'input di tastiera e mouse nelle sessioni in entrata. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableAudio">Consenti audio</string><string id="EnableAudio_Help">Stabilisce l'audio nelle sessioni in entrata. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableLanDiscovery">Consenti individuazione LAN</string><string id="EnableLanDiscovery_Help">Stabilisce se il dispositivo è individuabile nella rete locale. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="AllowAutoDisconnect">Abilita disconnessione automatica</string><string id="AllowAutoDisconnect_Help">Disconnette una sessione in entrata inattiva dopo il timeout configurato. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="AutoDisconnectTimeout">Timeout disconnessione automatica</string><string id="AutoDisconnectTimeout_Help">Imposta in minuti il timeout di inattività delle sessioni in entrata. Valore predefinito: 10 minuti. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="VerificationMethod">Metodo di verifica password</string><string id="VerificationMethod_Help">Seleziona quali password possono verificare una sessione in entrata. Valore predefinito: password temporanea e permanente. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="VerificationTemporary">Solo password temporanea</string><string id="VerificationPermanent">Solo password permanente</string><string id="VerificationBoth">Password temporanea e permanente</string>
      <string id="ApproveMode">Metodo di approvazione della sessione in entrata</string><string id="ApproveMode_Help">Seleziona se le sessioni in entrata sono accettate con password, clic o entrambi. Valore predefinito: entrambi. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="ApprovePassword">Password</string><string id="ApproveClick">Clic</string><string id="ApproveBoth">Entrambi</string>
      <string id="IdWhitelist">Elenco ID di connessione autorizzati</string><string id="IdWhitelist_Help">Imposta gli ID di connessione autorizzati separati da virgole. Sono supportati i caratteri jolly * e ?. Vuoto significa nessun filtro. L'ID è dichiarato dal client che si connette: usare questa impostazione come difesa in profondità, non come autenticazione. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="TemporaryPasswordRotation">Intervallo di rotazione della password temporanea</string><string id="TemporaryPasswordRotation_Help">Imposta ogni quanti minuti cambia la password temporanea. Impostare 0 per disabilitare la rotazione. I valori validi vanno da 0 a 1440. Se non configurata, la rotazione è disabilitata.</string>
      <string id="RequireProtectedDevice">Richiedi dispositivi di connessione protetti</string><string id="RequireProtectedDevice_Help">Richiede che il dispositivo di connessione superi il controllo di postura di sicurezza Clanto. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="PostureBypass">Elenco eccezioni postura di sicurezza</string><string id="PostureBypass_Help">Imposta gli ID delle regole di postura da ignorare su questo PC, separati da virgole. Valore predefinito: vuoto. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingFileTransfer">Consenti trasferimento file in uscita</string><string id="OutgoingFileTransfer_Help">Stabilisce il trasferimento file e la copia e incolla di file avviati da questo PC. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingClipboard">Consenti appunti in uscita</string><string id="OutgoingClipboard_Help">Stabilisce la condivisione degli appunti in entrambe le direzioni per le sessioni aperte da questo PC. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingTunnel">Consenti port forwarding e RDP in uscita</string><string id="OutgoingTunnel_Help">Stabilisce il port forwarding e le sessioni RDP avviate da questo PC. Valore predefinito: abilitati. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingTerminal">Consenti terminale in uscita</string><string id="OutgoingTerminal_Help">Stabilisce le sessioni terminale avviate da questo PC. Valore predefinito: abilitate. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingRemotePrinter">Consenti stampante remota in uscita</string><string id="OutgoingRemotePrinter_Help">Stabilisce i lavori di stampa inviati dall'host remoto alla stampante di questo PC. Valore predefinito: abilitati. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingRecord">Consenti registrazione sessione in uscita</string><string id="OutgoingRecord_Help">Stabilisce le registrazioni salvate su questo PC per le sessioni che apre. Valore predefinito: abilitate. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EventLogEnabled">Scrivi eventi audit nel registro eventi di Windows</string><string id="EventLogEnabled_Help">Stabilisce se gli eventi audit di ClantoDesk sono scritti nel registro eventi di Windows. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogEnabled">Invia eventi audit a syslog</string><string id="SyslogEnabled_Help">Stabilisce se gli eventi audit di ClantoDesk sono inviati a syslog. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogHost">Host syslog</string><string id="SyslogHost_Help">Imposta il nome o l'indirizzo dell'host del collettore syslog. Valore predefinito: vuoto. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogPort">Porta syslog</string><string id="SyslogPort_Help">Imposta la porta del collettore syslog. Valore predefinito: 514. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogProtocol">Protocollo syslog</string><string id="SyslogProtocol_Help">Seleziona il trasporto usato per gli eventi audit syslog. Valore predefinito: UDP. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogUdp">UDP</string><string id="SyslogTcp">TCP</string>
      <string id="SyslogFacility">Facility syslog</string><string id="SyslogFacility_Help">Imposta la facility syslog RFC 5424 da 0 a 23. Valore predefinito: 16 (local0). Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SessionLogDays">Conservazione report sessioni</string><string id="SessionLogDays_Help">Imposta per quanti giorni conservare i report delle sessioni in entrata. Impostare 0 per disabilitare il report locale delle sessioni ed eliminare i file di report esistenti. I valori validi vanno da 0 a 3650. Valore predefinito: 180. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="PrivacyPrompt">Chiedi di abilitare la modalità privacy</string><string id="PrivacyPrompt_Help">Stabilisce se ClantoDesk chiede di abilitare la modalità privacy all'inizio di ogni sessione di controllo remoto. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
    </stringTable>
    <presentationTable>
      <presentation id="EnableRemotePrinter"><text>$(string.Configure)</text></presentation><presentation id="EnableClipboard"><text>$(string.Configure)</text></presentation><presentation id="EnableFileTransfer"><text>$(string.Configure)</text></presentation><presentation id="EnableCamera"><text>$(string.Configure)</text></presentation><presentation id="EnableTerminal"><text>$(string.Configure)</text></presentation><presentation id="EnableTunnel"><text>$(string.Configure)</text></presentation><presentation id="EnableRemoteRestart"><text>$(string.Configure)</text></presentation><presentation id="EnableRecordSession"><text>$(string.Configure)</text></presentation><presentation id="EnableKeyboard"><text>$(string.Configure)</text></presentation><presentation id="EnableAudio"><text>$(string.Configure)</text></presentation><presentation id="EnableLanDiscovery"><text>$(string.Configure)</text></presentation><presentation id="AllowAutoDisconnect"><text>$(string.Configure)</text></presentation><presentation id="RequireProtectedDevice"><text>$(string.Configure)</text></presentation><presentation id="OutgoingFileTransfer"><text>$(string.Configure)</text></presentation><presentation id="OutgoingClipboard"><text>$(string.Configure)</text></presentation><presentation id="OutgoingTunnel"><text>$(string.Configure)</text></presentation><presentation id="OutgoingTerminal"><text>$(string.Configure)</text></presentation><presentation id="OutgoingRemotePrinter"><text>$(string.Configure)</text></presentation><presentation id="OutgoingRecord"><text>$(string.Configure)</text></presentation><presentation id="EventLogEnabled"><text>$(string.Configure)</text></presentation><presentation id="SyslogEnabled"><text>$(string.Configure)</text></presentation><presentation id="PrivacyPrompt"><text>$(string.Configure)</text></presentation>
      <presentation id="AutoDisconnectTimeout"><decimalTextBox refId="AutoDisconnectTimeoutValue"><label>$(string.Value)</label></decimalTextBox></presentation>
      <presentation id="VerificationMethod"><dropdownList refId="VerificationMethodValue"><label>$(string.Value)</label></dropdownList></presentation>
      <presentation id="ApproveMode"><dropdownList refId="ApproveModeValue"><label>$(string.Value)</label></dropdownList></presentation>
      <presentation id="IdWhitelist"><textBox refId="IdWhitelistValue"><label>$(string.Value)</label></textBox></presentation>
      <presentation id="TemporaryPasswordRotation"><decimalTextBox refId="TemporaryPasswordRotationValue"><label>$(string.Value)</label></decimalTextBox></presentation>
      <presentation id="PostureBypass"><textBox refId="PostureBypassValue"><label>$(string.Value)</label></textBox></presentation>
      <presentation id="SyslogHost"><textBox refId="SyslogHostValue"><label>$(string.Value)</label></textBox></presentation>
      <presentation id="SyslogPort"><decimalTextBox refId="SyslogPortValue"><label>$(string.Value)</label></decimalTextBox></presentation>
      <presentation id="SyslogProtocol"><dropdownList refId="SyslogProtocolValue"><label>$(string.Value)</label></dropdownList></presentation>
      <presentation id="SyslogFacility"><decimalTextBox refId="SyslogFacilityValue"><label>$(string.Value)</label></decimalTextBox></presentation>
      <presentation id="SessionLogDays"><decimalTextBox refId="SessionLogDaysValue"><label>$(string.Value)</label></decimalTextBox></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
