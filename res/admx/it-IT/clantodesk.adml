<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <displayName>ClantoDesk</displayName>
  <description>Impostazioni dei criteri di gruppo di ClantoDesk.</description>
  <resources>
    <stringTable>
      <string id="ClantoDesk150">ClantoDesk 1.5.0 o successivo</string>
      <string id="SessionPermissions">Permessi della sessione in entrata</string>
      <string id="InboundSecurity">Sicurezza in ingresso</string>
      <string id="OutgoingSessions">Sessioni in uscita</string>
      <string id="AuditSiem">Audit e SIEM</string>
      <string id="Interface">Interfaccia</string>
      <string id="Configure">Selezionare Abilitata o Disabilitata.</string>
      <string id="Value">Valore:</string>
      <string id="EnableRemotePrinter">Consenti stampante remota</string><string id="EnableRemotePrinter_Help">Stabilisce se le sessioni in entrata possono usare la stampante remota. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableClipboard">Consenti appunti</string><string id="EnableClipboard_Help">Stabilisce la condivisione degli appunti nelle sessioni in entrata. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableFileTransfer">Consenti trasferimento file</string><string id="EnableFileTransfer_Help">Stabilisce il trasferimento di file nelle sessioni in entrata. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableCamera">Consenti fotocamera</string><string id="EnableCamera_Help">Stabilisce l'accesso alla fotocamera nelle sessioni in entrata. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableTerminal">Consenti terminale</string><string id="EnableTerminal_Help">Stabilisce l'accesso al terminale nelle sessioni in entrata. Valore predefinito: disabilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableTunnel">Consenti tunneling TCP</string><string id="EnableTunnel_Help">Stabilisce il tunneling TCP nelle sessioni in entrata. Valore predefinito: disabilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableRemoteRestart">Consenti riavvio remoto</string><string id="EnableRemoteRestart_Help">Stabilisce il riavvio remoto nelle sessioni in entrata. Valore predefinito: disabilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableRecordSession">Consenti registrazione sessione</string><string id="EnableRecordSession_Help">Stabilisce la registrazione delle sessioni in entrata. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableKeyboard">Consenti tastiera e mouse</string><string id="EnableKeyboard_Help">Stabilisce l'input di tastiera e mouse nelle sessioni in entrata. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableAudio">Consenti audio</string><string id="EnableAudio_Help">Stabilisce l'audio nelle sessioni in entrata. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EnableLanDiscovery">Consenti individuazione LAN</string><string id="EnableLanDiscovery_Help">Stabilisce se il dispositivo è individuabile nella rete locale. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="AllowAutoDisconnect">Abilita disconnessione automatica</string><string id="AllowAutoDisconnect_Help">Disconnette una sessione in entrata inattiva dopo il timeout configurato. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="AutoDisconnectTimeout">Timeout disconnessione automatica</string><string id="AutoDisconnectTimeout_Help">Imposta in minuti il timeout di inattività delle sessioni in entrata. Valore predefinito: 10 minuti. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="VerificationMethod">Metodo di verifica password</string><string id="VerificationMethod_Help">Seleziona quali password possono verificare una sessione in entrata. Valore predefinito: password temporanea e permanente. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="VerificationTemporary">Solo password temporanea</string><string id="VerificationPermanent">Solo password permanente</string><string id="VerificationBoth">Password temporanea e permanente</string>
      <string id="ApproveMode">Metodo di approvazione della sessione in entrata</string><string id="ApproveMode_Help">Seleziona se le sessioni in entrata sono accettate con password, clic o entrambi. Valore predefinito: entrambi. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="ApprovePassword">Password</string><string id="ApproveClick">Clic</string><string id="ApproveBoth">Entrambi</string>
      <string id="IdWhitelist">Elenco ID di connessione autorizzati</string><string id="IdWhitelist_Help">Imposta gli ID di connessione autorizzati separati da virgole. Sono supportati i caratteri jolly * e ?. Vuoto significa nessun filtro. L'ID è dichiarato dal client che si connette: usare questa impostazione come difesa in profondità, non come autenticazione. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="IdPermissions">Permessi per gli ID autorizzati</string><string id="IdPermissions_Help">Imposta un oggetto JSON le cui chiavi sono le voci dell'elenco ID autorizzati, inclusi i pattern con caratteri jolly. Ogni valore può contenere un nome facoltativo e un profilo: view, support, full o custom. Un profilo custom contiene inoltre in perms i permessi abilitati. Le voci senza profilo mantengono il controllo completo. Un JSON non valido limita tutti gli ID autorizzati alla sola visualizzazione. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="TrustedControllers">Controller fidati (senza 2FA)</string><string id="TrustedControllers_Help">Elenca i controller che su questo computer non devono inserire il codice di autenticazione a due fattori, come voci ID=CHIAVE-DISPOSITIVO separate da virgole. La chiave del dispositivo è mostrata nelle impostazioni del controller o stampata da clantodesk --device-key. Un controller è fidato solo se dimostra, su questa connessione, di possedere quella chiave per il proprio ID: l'ID da solo non basta mai. La password resta obbligatoria. Le voci non valide sono ignorate. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="TemporaryPasswordRotation">Intervallo di rotazione della password temporanea</string><string id="TemporaryPasswordRotation_Help">Imposta ogni quanti minuti cambia la password temporanea. Impostare 0 per disabilitare la rotazione. I valori validi vanno da 0 a 1440. Se non configurata, la rotazione è disabilitata.</string>
      <string id="AccessHours">Fasce orarie di accesso</string><string id="AccessHours_Help">Le connessioni a questo computer sono accettate solo in queste fasce, nell'ora locale del computer. Voci separate da punto e virgola: giorni (mon..sun o lun..dom, intervalli come mon-fri o elenchi come sat,sun) seguiti da fasce HH:MM-HH:MM separate da virgola, ad esempio lun-ven 08:00-13:00,14:00-18:00; sab 09:00-12:00. Una fascia che finisce prima di iniziare prosegue nel giorno dopo. Vuota: a qualsiasi ora. Un valore non valido rifiuta ogni connessione.</string>
      <string id="RequireTwoFactor">Richiedi l'autenticazione a due fattori</string><string id="RequireTwoFactor_Help">Rifiuta ogni connessione in entrata finché su questo computer non è configurata l'autenticazione a due fattori. La policy non crea il segreto 2FA: un utente deve comunque attivare il 2FA in ClantoDesk e registrarlo in un'app di autenticazione. I controller fidati saltano il codice solo con il 2FA configurato. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="Privacy">Privacy</string><string id="ShareDeviceIdentity">Invia nome del computer e nome utente al server di gestione</string><string id="ShareDeviceIdentity_Help">Consente a ClantoDesk di includere il nome del computer e il nome dell'utente connesso nelle informazioni del dispositivo inviate al server API configurato. I nomi impostati dall'amministratore come nome dispositivo o utente del dispositivo sono sempre inviati. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="Forwarding">Forwarding</string>
      <string id="ForwardEnabled">Abilita il forwarding rete</string><string id="ForwardEnabled_Help">Abilita il forwarding rete (porte TCP) di ClantoDesk su questo computer, come host e come controller. Senza questa policy nessun inoltro di porte viene aperto in nessuna direzione. Il forwarding webcam ha policy proprie. Valore predefinito: disabilitata.</string>
      <string id="ForwardServicesHost">Servizi Clanto raggiungibili su questo computer</string><string id="ForwardServicesHost_Help">Servizi dell'elenco Clanto che il controller può raggiungere dalla parte di questo computer, come voci id=destinazione separate da punto e virgola, ad esempio rdp=localhost:3389;ssh=localhost:22. Sono consentiti solo questi servizi: l'elenco pubblicato aiuta a sceglierli ma da solo non attiva nulla. Valore predefinito: nessuno.</string>
      <string id="ForwardServicesController">Servizi Clanto di questo computer per il computer controllato</string><string id="ForwardServicesController_Help">Come controller, servizi dell'elenco Clanto dalla parte di questo computer che il computer controllato può raggiungere, come voci id=destinazione separate da punto e virgola. Valore predefinito: nessuno.</string>
      <string id="ForwardCustomHost">Consenti forward personalizzati verso la rete di questo computer</string><string id="ForwardCustomHost_Help">Come host, consente ai controller di raggiungere le destinazioni elencate in &quot;Destinazioni personalizzate dalla parte di questo computer&quot;, oltre ai servizi del catalogo. Valore predefinito: disabilitata.</string>
      <string id="ForwardCustomHostTargets">Destinazioni personalizzate dalla parte di questo computer</string><string id="ForwardCustomHostTargets_Help">Destinazioni che un controller può raggiungere attraverso questo computer: voci indirizzo:porte separate da virgole, dove indirizzo è nome host, IP, CIDR o * e porte è N, N-M o *. Esempio: localhost:3389, 192.168.10.0/24:443.</string>
      <string id="ForwardReverse">Consenti forward verso il controller</string><string id="ForwardReverse_Help">Come host, consente a questo computer di ascoltare su 127.0.0.1 e portare quelle connessioni al controller. Valore predefinito: disabilitata.</string>
      <string id="ForwardCustomController">Consenti forward personalizzati dalla rete di questo computer come controller</string><string id="ForwardCustomController_Help">Come controller, consente a un host di raggiungere le destinazioni elencate in &quot;Destinazioni personalizzate dalla parte del controller&quot;. Valore predefinito: disabilitata.</string>
      <string id="ForwardCustomControllerTargets">Destinazioni personalizzate dalla parte del controller</string><string id="ForwardCustomControllerTargets_Help">Destinazioni che un host può raggiungere attraverso questo computer quando fa da controller, nello stesso formato dell'elenco dell'host.</string>
      <string id="ForwardWebcam">Abilita il forwarding webcam</string><string id="ForwardWebcam_Help">Abilita il forwarding webcam di ClantoDesk su questo computer. Come host: la webcam del controller può comparire qui come camera virtuale (v4l2loopback su Linux, Windows 11, macOS 13 con l'estensione camera) e il controller può chiedere di usare la webcam di questo computer, che l'utente deve consentire ogni volta. Valore predefinito: disabilitata.</string>
      <string id="ForwardWebcamSend">Consenti la webcam di questo computer verso il computer controllato</string><string id="ForwardWebcamSend_Help">Come controller, consente di inviare la webcam di questo computer al computer controllato. Serve il forwarding webcam su entrambi i computer. Valore predefinito: disabilitata.</string>
      <string id="ForwardWebcamReceive">Consenti la webcam del computer controllato verso questo computer</string><string id="ForwardWebcamReceive_Help">Come controller, consente di chiedere la webcam del computer controllato per usarla qui come camera virtuale. L'utente del computer controllato deve consentirlo ogni volta. Valore predefinito: disabilitata.</string>
      <string id="ForwardCameraDevice">Dispositivo della camera virtuale (Linux)</string><string id="ForwardCameraDevice_Help">Dispositivo v4l2loopback che riceve la webcam del controller, ad esempio /dev/video10. Se vuoto, si usa il primo dispositivo v4l2loopback trovato.</string>
      <string id="RequireProtectedDevice">Richiedi dispositivi di connessione protetti</string><string id="RequireProtectedDevice_Help">Richiede che il dispositivo di connessione superi il controllo di postura di sicurezza Clanto. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="RequireControllerWatermark">Richiedi la filigrana del controller</string><string id="RequireControllerWatermark_Help">Richiede ai controller ClantoDesk che si connettono di mostrare una filigrana identificativa sulle sessioni desktop remote e di visualizzazione della fotocamera. È un deterrente applicato dal client e non protegge da un client modificato. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="HostWatermark">Mostra la filigrana sull'host</string><string id="HostWatermark_Help">Mostra codice sessione, tipo di accesso, permessi attivi, identità del controller, ora di inizio e numero di sessioni attive su ogni schermo dell'host durante sessioni desktop remoto e fotocamera autorizzate. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="PostureBypass">Elenco eccezioni postura di sicurezza</string><string id="PostureBypass_Help">Imposta gli ID delle regole di postura da ignorare su questo PC, separati da virgole. Valore predefinito: vuoto. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="FileScan">Controlla i file ricevuti dall'host</string><string id="FileScan_Help">Seleziona se i file in entrata completi non vengono controllati (off), vengono consegnati con un avviso di audit quando è rilevato malware o la scansione non è disponibile (warn), oppure vengono messi in quarantena e rifiutati in questi casi (block). Valore predefinito: off. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="FileScanOff">Disattivato</string><string id="FileScanWarn">Avvisa</string><string id="FileScanBlock">Blocca</string>
      <string id="FileScanClamd">Endpoint ClamAV clamd</string><string id="FileScanClamd_Help">Imposta l'endpoint clamd usato su macOS e Linux: un percorso di socket Unix oppure host:porta TCP. Un endpoint vuoto o irraggiungibile rende il file non scansionabile. Valore predefinito: vuoto. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="FileScanMaxMb">Dimensione massima del file da controllare</string><string id="FileScanMaxMb_Help">Imposta la dimensione massima in MiB dei file in entrata da controllare. I file più grandi sono trattati come non scansionabili. I valori validi vanno da 1 a 1048576. Valore predefinito: 512. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="FileDirection">Direzione consentita del trasferimento file dell'host</string><string id="FileDirection_Help">Seleziona se l'host consente trasferimenti in entrambe le direzioni, solo dal controller all'host, solo dall'host al controller oppure in nessuna direzione. Questa restrizione non abilita il trasferimento file se un'altra impostazione lo disabilita. Valore predefinito: entrambe le direzioni. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="FileDirectionBoth">Entrambe le direzioni</string><string id="FileDirectionToHost">Solo dal controller all'host</string><string id="FileDirectionFromHost">Solo dall'host al controller</string><string id="FileDirectionNone">Nessuna direzione</string>
      <string id="FileBlockedExt">Estensioni bloccate per i file in entrata</string><string id="FileBlockedExt_Help">Imposta le estensioni, separate da virgole, che l'host rifiuta prima di creare un file in entrata, anche dentro le cartelle trasferite. Non includere i punti. Il confronto non distingue maiuscole e minuscole e usa l'ultima estensione dopo aver rimosso punti e spazi finali. Esempio: exe,dll,ps1,bat,cmd,vbs,js,msi,scr,lnk. Valore predefinito: vuoto. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingFileTransfer">Consenti trasferimento file in uscita</string><string id="OutgoingFileTransfer_Help">Stabilisce il trasferimento file e la copia e incolla di file avviati da questo PC. Valore predefinito: abilitato. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingClipboard">Consenti appunti in uscita</string><string id="OutgoingClipboard_Help">Stabilisce la condivisione degli appunti in entrambe le direzioni per le sessioni aperte da questo PC. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingTunnel">Consenti port forwarding e RDP in uscita</string><string id="OutgoingTunnel_Help">Stabilisce il port forwarding e le sessioni RDP avviate da questo PC. Valore predefinito: abilitati. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingTerminal">Consenti terminale in uscita</string><string id="OutgoingTerminal_Help">Stabilisce le sessioni terminale avviate da questo PC. Valore predefinito: abilitate. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingRemotePrinter">Consenti stampante remota in uscita</string><string id="OutgoingRemotePrinter_Help">Stabilisce i lavori di stampa inviati dall'host remoto alla stampante di questo PC. Valore predefinito: abilitati. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="OutgoingRecord">Consenti registrazione sessione in uscita</string><string id="OutgoingRecord_Help">Stabilisce le registrazioni salvate su questo PC per le sessioni che apre. Valore predefinito: abilitate. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="EventLogEnabled">Scrivi eventi audit nel registro eventi di Windows</string><string id="EventLogEnabled_Help">Stabilisce se gli eventi audit di ClantoDesk sono scritti nel registro eventi di Windows. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogEnabled">Invia eventi audit a syslog</string><string id="SyslogEnabled_Help">Stabilisce se gli eventi audit di ClantoDesk sono inviati a syslog. Valore predefinito: disabilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogHost">Host syslog</string><string id="SyslogHost_Help">Imposta il nome o l'indirizzo dell'host del collettore syslog. Valore predefinito: vuoto. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogPort">Porta syslog</string><string id="SyslogPort_Help">Imposta la porta del collettore syslog. Se non è configurata una porta locale, il valore predefinito è 514 per UDP e TCP oppure 6514 per TLS. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogProtocol">Protocollo syslog</string><string id="SyslogProtocol_Help">Seleziona UDP, TCP o TLS per gli eventi audit syslog. Valore predefinito: TLS; UDP e TCP inviano gli eventi in chiaro. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogUdp">UDP</string><string id="SyslogTcp">TCP</string><string id="SyslogTls">TLS</string>
      <string id="SyslogFacility">Facility syslog</string><string id="SyslogFacility_Help">Imposta la facility syslog RFC 5424 da 0 a 23. Valore predefinito: 16 (local0). Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogTlsCa">File CA del collettore syslog TLS</string><string id="SyslogTlsCa_Help">Imposta il percorso del file PEM contenente la CA usata esclusivamente per verificare il collettore TLS. La consegna TLS è disabilitata se il percorso è vuoto, il file è illeggibile o non contiene certificati validi. Le CA di sistema non vengono usate. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogFormat">Formato audit syslog</string><string id="SyslogFormat_Help">Seleziona il formato RFC 5424 o CEF per gli eventi audit syslog. Valore predefinito: RFC 5424. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="SyslogRfc5424">RFC 5424</string><string id="SyslogCef">CEF</string>
      <string id="SessionLogDays">Conservazione report sessioni</string><string id="SessionLogDays_Help">Imposta per quanti giorni conservare i report delle sessioni in entrata. Impostare 0 per disabilitare il report locale delle sessioni ed eliminare i file di report esistenti. I valori validi vanno da 0 a 3650. Valore predefinito: 180. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="PrivacyPrompt">Chiedi di abilitare la modalità privacy</string><string id="PrivacyPrompt_Help">Stabilisce se ClantoDesk chiede di abilitare la modalità privacy all'inizio di ogni sessione di controllo remoto. Valore predefinito: abilitata. Se non configurata, viene usata l'impostazione locale di ClantoDesk.</string>
      <string id="LockSettings">Impedisci la modifica delle impostazioni di ClantoDesk</string><string id="LockSettings_Help">Rende tutte le impostazioni di ClantoDesk di sola lettura per tutti gli utenti, inclusi gli amministratori. Tema e lingua restano modificabili. Le scritture da interfaccia, IPC e riga di comando vengono rifiutate. Valore predefinito: disabilitata.</string>
    </stringTable>
    <presentationTable>
      <presentation id="EnableRemotePrinter"><text>$(string.Configure)</text></presentation><presentation id="EnableClipboard"><text>$(string.Configure)</text></presentation><presentation id="EnableFileTransfer"><text>$(string.Configure)</text></presentation><presentation id="EnableCamera"><text>$(string.Configure)</text></presentation><presentation id="EnableTerminal"><text>$(string.Configure)</text></presentation><presentation id="EnableTunnel"><text>$(string.Configure)</text></presentation><presentation id="EnableRemoteRestart"><text>$(string.Configure)</text></presentation><presentation id="EnableRecordSession"><text>$(string.Configure)</text></presentation><presentation id="EnableKeyboard"><text>$(string.Configure)</text></presentation><presentation id="EnableAudio"><text>$(string.Configure)</text></presentation><presentation id="EnableLanDiscovery"><text>$(string.Configure)</text></presentation><presentation id="AllowAutoDisconnect"><text>$(string.Configure)</text></presentation><presentation id="RequireProtectedDevice"><text>$(string.Configure)</text></presentation><presentation id="AccessHours"><textBox refId="AccessHoursValue"><label>$(string.Value)</label></textBox></presentation><presentation id="RequireTwoFactor"><text>$(string.Configure)</text></presentation><presentation id="ShareDeviceIdentity"><text>$(string.Configure)</text></presentation><presentation id="ForwardEnabled"><text>$(string.Configure)</text></presentation><presentation id="ForwardServicesHost"><textBox refId="ForwardServicesHostValue"><label>$(string.Value)</label></textBox></presentation><presentation id="ForwardServicesController"><textBox refId="ForwardServicesControllerValue"><label>$(string.Value)</label></textBox></presentation><presentation id="ForwardCustomHost"><text>$(string.Configure)</text></presentation><presentation id="ForwardCustomHostTargets"><textBox refId="ForwardCustomHostTargetsValue"><label>$(string.Value)</label></textBox></presentation><presentation id="ForwardReverse"><text>$(string.Configure)</text></presentation><presentation id="ForwardCustomController"><text>$(string.Configure)</text></presentation><presentation id="ForwardCustomControllerTargets"><textBox refId="ForwardCustomControllerTargetsValue"><label>$(string.Value)</label></textBox></presentation><presentation id="ForwardWebcam"><text>$(string.Configure)</text></presentation><presentation id="ForwardWebcamSend"><text>$(string.Configure)</text></presentation><presentation id="ForwardWebcamReceive"><text>$(string.Configure)</text></presentation><presentation id="ForwardCameraDevice"><textBox refId="ForwardCameraDeviceValue"><label>$(string.Value)</label></textBox></presentation><presentation id="RequireControllerWatermark"><text>$(string.Configure)</text></presentation><presentation id="OutgoingFileTransfer"><text>$(string.Configure)</text></presentation><presentation id="OutgoingClipboard"><text>$(string.Configure)</text></presentation><presentation id="OutgoingTunnel"><text>$(string.Configure)</text></presentation><presentation id="OutgoingTerminal"><text>$(string.Configure)</text></presentation><presentation id="OutgoingRemotePrinter"><text>$(string.Configure)</text></presentation><presentation id="OutgoingRecord"><text>$(string.Configure)</text></presentation><presentation id="EventLogEnabled"><text>$(string.Configure)</text></presentation><presentation id="SyslogEnabled"><text>$(string.Configure)</text></presentation><presentation id="PrivacyPrompt"><text>$(string.Configure)</text></presentation>
      <presentation id="AutoDisconnectTimeout"><decimalTextBox refId="AutoDisconnectTimeoutValue"><label>$(string.Value)</label></decimalTextBox></presentation>
      <presentation id="VerificationMethod"><dropdownList refId="VerificationMethodValue"><label>$(string.Value)</label></dropdownList></presentation>
      <presentation id="ApproveMode"><dropdownList refId="ApproveModeValue"><label>$(string.Value)</label></dropdownList></presentation>
      <presentation id="IdWhitelist"><textBox refId="IdWhitelistValue"><label>$(string.Value)</label></textBox></presentation>
      <presentation id="IdPermissions"><textBox refId="IdPermissionsValue"><label>$(string.Value)</label></textBox></presentation>
      <presentation id="TrustedControllers"><textBox refId="TrustedControllersValue"><label>$(string.Value)</label></textBox></presentation>
      <presentation id="TemporaryPasswordRotation"><decimalTextBox refId="TemporaryPasswordRotationValue"><label>$(string.Value)</label></decimalTextBox></presentation>
      <presentation id="PostureBypass"><textBox refId="PostureBypassValue"><label>$(string.Value)</label></textBox></presentation>
      <presentation id="FileScan"><dropdownList refId="FileScanValue"><label>$(string.Value)</label></dropdownList></presentation>
