# Immagine per verificare la parte Flutter senza SDK in locale: genera il
# bridge Rust<->Dart come il workflow bridge.yml, poi analyze, test Dart e
# cargo check con la feature `flutter`.
#
# Parte dall'immagine di docker/Dockerfile.check (Rust e librerie di sistema).
# NON USARE PER: build di release.
#
# Uso:  docker/flutter-check.sh
FROM clantodesk-check

ARG DEBIAN_FRONTEND=noninteractive
# Allineate a env.FLUTTER_VERSION di flutter-build.yml e a bridge.yml.
ARG FLUTTER_VERSION=3.24.5
ARG FLUTTER_RUST_BRIDGE_VERSION=1.80.1
ARG CARGO_EXPAND_VERSION=1.0.95

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update -y && apt-get install --yes --no-install-recommends \
        unzip xz-utils cmake ninja-build file

RUN curl -fsSL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
      | tar -xJ -C /opt \
    && git config --global --add safe.directory /opt/flutter
ENV PATH=/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:$PATH \
    FLUTTER_SUPPRESS_ANALYTICS=true \
    DART_SUPPRESS_ANALYTICS=true
RUN flutter config --no-analytics && flutter precache --linux --no-android --no-ios

# Registry e build degli strumenti in cache BuildKit: non finiscono nell'immagine.
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/tmp/cargo-install-target \
    rustup component add rustfmt \
    && CARGO_TARGET_DIR=/tmp/cargo-install-target \
       cargo install cargo-expand --version ${CARGO_EXPAND_VERSION} --locked \
    && CARGO_TARGET_DIR=/tmp/cargo-install-target \
       cargo install flutter_rust_bridge_codegen --version ${FLUTTER_RUST_BRIDGE_VERSION} \
         --features uuid --locked

WORKDIR /work
